{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/node",
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.browser.ts",
    "src/platform/browser.ts",
    "src/grpc/client.browser.ts",
    "src/index.browser.ts",
    "src/retry.browser.ts"
  ]
}
