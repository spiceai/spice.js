{
  "name": "@spiceai/spice",
  "description": "JS + TS SDK for spice.ai",
  "version": "2.0.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": "git@github.com:spiceai/spice.js.git",
  "author": "Spice AI, Inc. <webmaster@spice.ai>",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "1.14.0",
    "@grpc/proto-loader": "0.7.13",
    "@types/node": "^18.19.129",
    "@types/node-fetch": "^2.6.12",
    "@types/retry": "^0.12.5",
    "apache-arrow": "21.0.0",
    "glob": "^11.0.3",
    "node-fetch": "^2",
    "protobufjs": "^7.5.4",
    "retry": "^0.13.1",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "node -e \"require('fs').mkdirSync('dist/proto', {recursive: true}); require('fs').copyFileSync('proto/Flight.proto', 'dist/proto/Flight.proto')\"",
    "run": "node dist/index.js",
    "pretest": "npm run build",
    "test": "jest",
    "dev": "npx nodemon --exec ts-node ./test/index.ts --watch test --ext .ts",
    "preversion": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "dotenv": "^17.2.3",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.1"
  }
}