# Spice.ai API Key
# Get your API key from https://spice.ai
SPICEAI_API_KEY=your_api_key_here

# Spice Cloud Environment
# 'prod' - Production (default)
# 'dev' - Development (use for testing parameterized queries with prepare/execute)
# SPICE_ENVIRONMENT=dev

# Optional: Override default endpoints for testing
# These override the environment setting above
# Production (default):
# HTTP_URL=https://data.spiceai.io
# FLIGHT_URL=flight.spiceai.io:443

# Development (use for testing parameterized queries with prepare/execute):
# HTTP_URL=https://dev-data.spiceai.io
# FLIGHT_URL=dev-flight.spiceai.io:443

# Optional: Vercel deployment testing
# VERCEL_ENDPOINT=https://spice-js.vercel.app/api
# VERCEL_AUTOMATION_BYPASS_SECRET=your_secret_here
